{
  "name": "king-jack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy-pages.sh",
    "bundle:game": "node scripts/sync-engine.mjs && npx -y esbuild@0.25.0 supabase/functions/game/index.ts --bundle --format=esm --platform=neutral --target=es2022 --external:npm:* --minify-whitespace --minify-syntax --legal-comments=none --charset=utf8 --outfile=supabase/functions/game/dist/index.js"
  },
  "dependencies": {
    "@fontsource/rubik": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
